# behavior
set shell sh
set shellopts '-eu'
set ifs "\n"
set scrolloff 10
set hidden
set info size:time

# navigation / UI
map <space>
map v toggle
map gh cd ~
map zh set hidden!
map zr set reverse!

# editor / shell
map e $nvim -u ~/.vimrc "$f" < /dev/tty > /dev/tty
map i $less -R "$f" 

# copy / paste
map y copy
map <space>c copy_name
map <space>p copy_dir
map p paste
map d delete
map c push :mkdir<space>

# reusable commands
cmd copy_name ${{
    if [ "${1:-}" = directory ]; then
        name=$PWD
    else
        [ -n "${f:-}" ] || exit 0
        name=${f##*/}
    fi
    case "$(uname -s)" in
        Darwin) printf '%s' "$name" | pbcopy ;;
        *)
            # Requires terminal OSC 52 support; tmux also needs set-clipboard enabled.
            if [ -n "${TMUX:-}" ]; then
                printf '%s' "$name" | tmux load-buffer -w -
            else
                encoded=$(printf '%s' "$name" | base64 | tr -d '\r\n')
                printf '\033]52;c;%s\007' "$encoded" > /dev/tty
            fi
            ;;
    esac
}}

cmd copy_dir copy_name directory

cmd mkdir $mkdir -p "$1"; reload
#cmd trash ${{ mkdir -p ~/.trash; mv $fx ~/.trash; }}
cmd open &$OPENER "$f"

# preview
set preview
set previewer ~/.config/lf/preview
set cleaner ~/.config/lf/clean

# normal delete: permanently remove
cmd delete ${{
    rm -rf -- $fx
    lf -remote "send $id reload"
    lf -remote "send $id select \"$target\""
}}

map D delete

# fzf: jump to file/dir under current directory
cmd fzf_jump ${{
    res="$(find . -mindepth 1 2>/dev/null | sed 's#^\./##' | fzf --reverse --prompt='jump> ')" || exit 0
    esc=$(printf '%s\n' "$res" | sed 's/\\/\\\\/g; s/"/\\"/g')
    if [ -d "$res" ]; then
        lf -remote "send $id cd \"$esc\""
    else
        lf -remote "send $id select \"$esc\""
    fi
}}

map <c-f> fzf_jump
